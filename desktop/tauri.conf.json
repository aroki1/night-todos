{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Night Sky",
  "version": "11.0.0",
  "identifier": "app.nightsky.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Night Sky",
        "width": 1280,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "backgroundColor": "#030407",
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
